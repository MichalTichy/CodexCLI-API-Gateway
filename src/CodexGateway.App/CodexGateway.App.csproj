<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 10 ships Blazor's bootstrap scripts as web assets; require them in Linux publish output. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.2.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.2.0" />
    <!-- Keep the exact pre-license-key release; do not float to MediatR 13+. -->
    <PackageReference Include="MediatR" Version="[12.5.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGateway.Api\CodexGateway.Api.csproj" />
    <ProjectReference Include="..\CodexGateway.Api.OpenAI\CodexGateway.Api.OpenAI.csproj" />
    <ProjectReference Include="..\..\SharedInfrastructure\Shared.Infrastructure.IoC\Shared.Infrastructure.IoC.csproj" />
    <ProjectReference Include="..\..\SharedInfrastructure\Shared.Infrastructure.Initializer\Shared.Infrastructure.Initializer.csproj" />
    <ProjectReference Include="..\CodexGateway.Models\CodexGateway.Models.csproj" />
    <ProjectReference Include="..\CodexGateway.Logic\CodexGateway.Logic.csproj" />
    <ProjectReference Include="..\CodexGateway.Infrastructure.Codex\CodexGateway.Infrastructure.Codex.csproj" />
    <ProjectReference Include="..\CodexGateway.McpGateway\CodexGateway.McpGateway.csproj" />
    <ProjectReference Include="..\CodexGateway.McpGateway.Http\CodexGateway.McpGateway.Http.csproj" />
    <ProjectReference Include="..\CodexGateway.McpGateway.Stdio\CodexGateway.McpGateway.Stdio.csproj" />
    <ProjectReference Include="..\CodexGateway.Infrastructure.Persistence\CodexGateway.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\CodexGateway.Infrastructure.FileStorage\CodexGateway.Infrastructure.FileStorage.csproj" />
    <ProjectReference Include="..\CodexGateway.ServiceDefaults\CodexGateway.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
