@namespace CodexGateway.App.Components.Pages.Admin.ApiKeys
@inherits AdminComponentBase

<section class="content-section" aria-labelledby="keys-heading">
    <div class="section-title-row">
        <div>
            <h2 id="keys-heading">API keys</h2>
            <p>Create a credential here, then grant it access inside a project.</p>
        </div>
    </div>

    <EditForm Model="_create" OnValidSubmit="CreateAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="flex-col items-start gap-1">
                <h3>Create API key</h3>
                <p>Choose a stable identifier that explains who or what will use this credential.</p>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-5">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <LumexTextbox id="new-api-key-id"
                                      Behavior="@InputBehavior.OnInput"
                                      @bind-Value="_create.Id"
                                      Label="Identifier"
                                      Placeholder="automation"
                                      Description="Lowercase identifier used in project grants."
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Id" />
                    </div>
                    <div>
                        <LumexTextbox id="new-api-key-name"
                                      Behavior="@InputBehavior.OnInput"
                                      @bind-Value="_create.Name"
                                      Label="Display name"
                                      Placeholder="Automation"
                                      Description="Human-readable name shown throughout the UI."
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Name" />
                    </div>
                </div>
                <div class="flex justify-end">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@IsBusy">
                        @(IsBusy ? "Creating…" : "Create API key")
                    </LumexButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(Status))
                {
                    <LumexAlert Color="@(StatusKind == AdminStatusKind.Error ? ThemeColor.Danger : ThemeColor.Default)" Description="@Status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>

    @if (_createdApiKey is not null)
    {
        <LumexAlert Color="@ThemeColor.Warning" Title="Copy API key now" role="status" aria-live="polite">
            <DescriptionContent>
                <div class="grid gap-3">
                    <p>This is the only time the secret for <strong>@_createdApiKey.Name</strong> will be shown.</p>
                    <LumexTextbox id="created-api-key-secret"
                                  Value="@_createdApiKey.Key"
                                  Label="Secret"
                                  ReadOnly="@true"
                                  LabelPlacement="@LabelPlacement.Outside"
                                  Variant="@InputVariant.Outlined"
                                  Class="font-mono" />
                </div>
            </DescriptionContent>
        </LumexAlert>
    }

    <LumexCard Class="form-card">
        <LumexCardHeader Class="flex-row items-center justify-between">
            <div>
                <h3>Active credentials</h3>
                <p>@ApiKeys.Count configured</p>
            </div>
            <LumexChip Variant="@ChipVariant.Flat">@ApiKeys.Count</LumexChip>
        </LumexCardHeader>
        <LumexDivider />
        <LumexCardBody>
            @if (ApiKeys.Count == 0)
            {
                <div class="empty-state">No API keys are configured.</div>
            }
            else
            {
                <div class="key-list" aria-labelledby="keys-heading">
                    @foreach (var key in ApiKeys)
                    {
                        <div class="list-row" @key="key.Id">
                            <div class="flex min-w-0 items-center gap-3">
                                <div class="list-avatar" aria-hidden="true">@key.Name[..1].ToUpperInvariant()</div>
                                <div class="min-w-0">
                                    <strong class="block truncate text-sm text-foreground">@key.Name</strong>
                                    <span class="block truncate font-mono text-xs text-foreground-400">@key.Id</span>
                                </div>
                            </div>
                            <LumexButton Color="@ThemeColor.Danger" Variant="@Variant.Light" Size="@Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteAsync(key.Id))">Revoke</LumexButton>
                        </div>
                    }
                </div>
            }
        </LumexCardBody>
    </LumexCard>
</section>
