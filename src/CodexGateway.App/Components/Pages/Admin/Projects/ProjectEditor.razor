@namespace CodexGateway.App.Components.Pages.Admin.Projects

<article aria-busy="@_busy.ToString().ToLowerInvariant()">
    <EditForm Model="_editor" OnValidSubmit="SaveAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="responsive-row">
                <div>
                    <h3>@Project.Name</h3>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <LumexChip Color="@(Project.Enabled ? ThemeColor.Success : ThemeColor.Default)" Variant="@ChipVariant.Dot" Size="@Size.Small">@(Project.Enabled ? "Enabled" : "Disabled")</LumexChip>
                        <span class="font-mono text-xs text-foreground-400">@Project.Id</span>
                    </div>
                </div>
                <div class="flex flex-wrap justify-end gap-2">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@_busy">@(_busy ? "Saving…" : "Save project")</LumexButton>
                    @if (_confirmDelete)
                    {
                        <div class="confirmation-panel" role="group" aria-label="Confirm project deletion">
                            <span>Delete the project and its stored artifacts?</span>
                            <LumexButton Color="@ThemeColor.Danger" Size="@Size.Small" Disabled="@_busy" OnClick="DeleteAsync">Confirm</LumexButton>
                            <LumexButton Variant="@Variant.Light" Size="@Size.Small" Disabled="@_busy" OnClick="CancelDelete">Cancel</LumexButton>
                        </div>
                    }
                    else
                    {
                        <LumexButton Color="@ThemeColor.Danger" Variant="@Variant.Light" Disabled="@_busy" OnClick="ConfirmDelete">Delete</LumexButton>
                    }
                </div>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-6">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <LumexTextbox id="@($"project-name-{Project.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Name" Label="Project name" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _editor.Name" />
                    </div>
                    <label class="toggle-field" for="@($"project-enabled-{Project.Id}")">
                        <InputCheckbox id="@($"project-enabled-{Project.Id}")" @bind-Value="_editor.Enabled" />
                        <span><strong>Enabled</strong><small>Accept requests for this project</small></span>
                    </label>
                    <div class="sm:col-span-2">
                        <LumexTextbox id="@($"project-runner-image-{Project.Id}")"
                                      Behavior="@InputBehavior.OnInput"
                                      @bind-Value="_editor.RunnerImage"
                                      Label="Runner image"
                                      Placeholder="Use the default runner image"
                                      Description="Optional container image override for this project's runs."
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _editor.RunnerImage" />
                    </div>
                </div>

                <LumexDivider />
                <div class="section-title-row">
                    <div>
                        <h4>API-key access</h4>
                        <p>Grant project access first, then select the MCP servers and individual tools.</p>
                    </div>
                    <LumexChip Variant="@ChipVariant.Flat" Size="@Size.Small">@_editor.ApiKeys.Count keys</LumexChip>
                </div>

                @if (_editor.ApiKeys.Count == 0)
                {
                    <div class="empty-state">Configure a gateway API key before granting project access.</div>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var access in _editor.ApiKeys)
                        {
                            <section class="access-card @(!access.HasProjectAccess ? "access-card-disabled" : null)" @key="access.Id">
                                <header class="access-card-header">
                                    <label class="toggle-field toggle-field-compact" for="@($"access-{Project.Id}-{access.Id}")">
                                        <input id="@($"access-{Project.Id}-{access.Id}")" type="checkbox" @bind="access.HasProjectAccess" />
                                        <span><strong>@access.Name</strong><small class="font-mono">@access.Id</small></span>
                                    </label>
                                    <LumexChip Color="@(access.HasProjectAccess ? ThemeColor.Success : ThemeColor.Default)" Variant="@ChipVariant.Dot" Size="@Size.Small">
                                        @(access.HasProjectAccess ? "Project access" : "No access")
                                    </LumexChip>
                                </header>

                                @if (access.Servers.Count == 0)
                                {
                                    <div class="empty-state empty-state-compact">No MCP servers are configured.</div>
                                }
                                else
                                {
                                    <div class="grant-list">
                                        @foreach (var server in access.Servers)
                                        {
                                            var serverAvailable = access.HasProjectAccess && server.CatalogEnabled;
                                            var toolsAvailable = serverAvailable && server.Granted;
                                            <section class="server-grant" @key="server.Id">
                                                <header class="server-grant-header">
                                                    <label class="toggle-field toggle-field-compact" for="@($"grant-{Project.Id}-{access.Id}-{server.Id}")">
                                                        <input id="@($"grant-{Project.Id}-{access.Id}-{server.Id}")" type="checkbox" @bind="server.Granted" disabled="@(!serverAvailable)" />
                                                        <span><strong>@server.Name</strong><small>MCP server</small></span>
                                                    </label>
                                                    <div class="flex flex-wrap items-center justify-end gap-2">
                                                        <LumexChip Color="@(server.CatalogEnabled ? ThemeColor.Success : ThemeColor.Default)" Variant="@ChipVariant.Dot" Size="@Size.Small">
                                                            @(server.CatalogEnabled ? "Catalog enabled" : "Catalog disabled")
                                                        </LumexChip>
                                                        <label class="inline-check" for="@($"required-{Project.Id}-{access.Id}-{server.Id}")">
                                                            <input id="@($"required-{Project.Id}-{access.Id}-{server.Id}")" type="checkbox" @bind="server.Required" disabled="@(!toolsAvailable)" />
                                                            <span>Required</span>
                                                        </label>
                                                    </div>
                                                </header>

                                                @if (server.Tools.Count == 0)
                                                {
                                                    <span class="text-xs text-foreground-400">No catalog tools</span>
                                                }
                                                else
                                                {
                                                    <div class="tool-table">
                                                        <div class="tool-row tool-row-header" aria-hidden="true"><span>Tool</span><span>Access</span></div>
                                                        @foreach (var tool in server.Tools)
                                                        {
                                                            <div class="tool-row" @key="tool.Name">
                                                                <code>@tool.Name</code>
                                                                <label class="inline-check">
                                                                    <InputCheckbox @bind-Value="tool.Enabled" disabled="@(!toolsAvailable)" />
                                                                    <span>Allow</span>
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <LumexAlert Color="@(_statusKind == "error" ? ThemeColor.Danger : ThemeColor.Default)" Description="@_status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>
</article>
