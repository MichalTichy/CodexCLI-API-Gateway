@namespace CodexGateway.App.Components.Pages.Admin.Projects

<article class="project-detail" aria-busy="@_busy.ToString().ToLowerInvariant()">
    <NavigationLock ConfirmExternalNavigation="@IsDirty" />
    <EditForm Model="_editor" OnValidSubmit="SaveAsync" autocomplete="off">
        <fieldset disabled="@_busy" class="editor-fields">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="detail-savebar" data-testid="project-savebar">
            <div class="savebar-context"><strong>@Project.Name</strong><small>@Project.Id @SelectedContext</small><span class="save-state @SaveStateClass" role="status">@SaveState</span></div>
            <div class="editor-toolbar-actions">
                <LumexButton Type="@ButtonType.Button" Variant="@Variant.Light" Disabled="@(_busy || !IsDirty)" OnClick="DiscardChanges">@AdminUx.Text("Discard")</LumexButton>
                <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@(_busy || !IsDirty || HasExternalChanges)">Save changes</LumexButton>
            </div>
        </div>
        @if (IsDirty) { <details class="change-summary"><summary>@AdminUx.Format("ReviewChanges", PendingChanges.Count)</summary><ul>@foreach (var change in PendingChanges) { <li>@change</li> }</ul></details> }
        @if (HasExternalChanges) { <p class="tool-metadata-note tool-metadata-warning" role="alert">@AdminUx.Text("ExternalChanges")</p> }
        <nav class="detail-tabs" aria-label="@AdminUx.Text("ProjectSections")">
            <button type="button" aria-pressed="@(_tab == "access")" @onclick='() => _tab = "access"'>@AdminUx.Text("Access")</button>
            <button type="button" aria-pressed="@(_tab == "settings")" @onclick='() => _tab = "settings"'>@AdminUx.Text("Settings")</button>
            <button type="button" aria-pressed="@(_tab == "runner")" @onclick='() => _tab = "runner"'>@AdminUx.Text("Runner")</button>
        </nav>
        <div class="detail-body">
        @if (_tab == "settings")
        {
            <div class="form-grid-two">
                <div><LumexTextbox id="@($"project-name-{Project.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Name" Label="Project name" aria-label="Project name" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" /><ValidationMessage For="() => _editor.Name" /></div>
                <label class="toggle-field"><InputCheckbox @bind-Value="_editor.Enabled" /><span><strong>Accept API requests</strong><small>Turn off to block new requests for this project.</small></span></label>
            </div>
            <div class="danger-zone"><LumexButton Type="@ButtonType.Button" Color="@ThemeColor.Danger" Variant="@Variant.Light" Disabled="@_busy" OnClick="ConfirmDelete">Delete project</LumexButton></div>
        }
        else if (_tab == "runner")
        {
            <label for="@($"project-runner-image-{Project.Id}")">Runner container image (optional)</label>
            <LumexTextbox id="@($"project-runner-image-{Project.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.RunnerImage" aria-label="Runner container image" Placeholder="e.g. registry.example/codex-runner:1.0" Variant="@InputVariant.Outlined" />
            <p class="field-help">Leave blank to use the configured default for future runs.</p><ValidationMessage For="() => _editor.RunnerImage" />
        }
        else
        {
            <div class="section-title-row"><div><h4>API-key access</h4><p>@AdminUx.Text("AccessInstructions")</p></div><span class="field-help">@AdminUx.Format("ProjectCounts", GrantedApiKeyCount, GrantedServerCount, EnabledToolCount)</span></div>
            @if (_editor.ApiKeys.Count == 0) { <div class="empty-state">Configure a gateway API key before granting project access.</div> }
            else
            {
                <div class="access-matrix-wrap">
                    <table class="access-matrix" aria-label="@AdminUx.Text("AccessMatrix")">
                        <thead><tr><th scope="col">API key</th>@foreach (var catalogServer in Servers) { <th scope="col">@catalogServer.Name</th> }</tr></thead>
                        <tbody>
                        @foreach (var key in _editor.ApiKeys)
                        {
                            <tr class="@(key.Id == _selectedKeyId ? "selected-key" : null)">
                                <th scope="row"><button type="button" class="matrix-key" @onclick="() => SelectKey(key.Id)"><strong>@key.Name</strong><small>@key.Id</small><small>@(key.HasProjectAccess ? AdminUx.Text("Allowed") : AdminUx.Text("NoAccess"))</small></button></th>
                                @foreach (var grant in key.Servers)
                                {
                                    <td><button type="button" class="matrix-cell @(key.Id == _selectedKeyId && grant.Id == _selectedServerId ? "selected-cell" : null)" aria-label="@MatrixCellLabel(key, grant)" @onclick="() => SelectGrant(key.Id, grant.Id)">
                                        <span>@GrantSummary(key, grant)</span>
                                        @if (HasGrantAccess(key, grant))
                                        {
                                            @if (HasRiskCounts(grant))
                                            {
                                                <span class="matrix-risk-counts" title="@AdminUx.Text("MatrixRiskExplanation")">
                                                    <span class="risk-badge @(grant.AllowedDestructiveToolCount > 0 ? "risk-destructive" : "risk-unknown")">@if (grant.AllowedDestructiveToolCount > 0) { <span aria-hidden="true">⚠</span> }@AdminUx.Format("MatrixDestructiveTools", grant.AllowedDestructiveToolCount)</span>
                                                    @if (grant.AllowedUnknownRiskToolCount > 0) { <span class="risk-badge risk-unknown">@AdminUx.Format("MatrixUnknownTools", grant.AllowedUnknownRiskToolCount)</span> }
                                                </span>
                                            }
                                            else { <span class="matrix-risk-status">@MatrixRiskStatus(grant)</span> }
                                        }
                                    </button></td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (SelectedKey is { } access)
                {
                    <section class="selected-access" aria-label="@access.Name">
                        <div class="section-title-row"><div><h4>@access.Name</h4><small class="field-help">@access.Id</small></div><label class="inline-check"><input type="checkbox" @bind="access.HasProjectAccess" /><span>@AdminUx.Text("ProjectAccess")</span></label></div>
                        <div class="grant-selector">
                            <div class="native-field"><label for="@($"selected-server-{Project.Id}")">MCP server</label><select id="@($"selected-server-{Project.Id}")" class="native-select" value="@_selectedServerId" @onchange="SelectServer">@foreach (var grant in access.Servers) { <option value="@grant.Id">@grant.Name</option> }</select></div>
                            <div class="native-field"><label for="@($"web-search-{Project.Id}-{access.Id}")">Codex web search</label><InputSelect id="@($"web-search-{Project.Id}-{access.Id}")" class="native-select" @bind-Value="access.WebSearchMode" disabled="@(!access.HasProjectAccess)"><option value="@WebSearchMode.Disabled">Disabled</option><option value="@WebSearchMode.Cached">Cached index</option><option value="@WebSearchMode.Indexed">Indexed web</option><option value="@WebSearchMode.Live">Live web</option></InputSelect></div>
                        </div>
                        @if (SelectedServer is { } server)
                        {
                            var toolsAvailable = access.HasProjectAccess && server.CatalogEnabled && server.Granted;
                            <div class="server-access-controls">
                                <label class="inline-check"><input type="checkbox" @bind="server.Granted" disabled="@(!access.HasProjectAccess || !server.CatalogEnabled)" /><span>@AdminUx.Format("AllowServer", server.Name)</span></label>
                                <label class="inline-check"><input type="checkbox" @bind="server.Required" disabled="@(!toolsAvailable)" /><span>Fail run if unavailable</span></label>
                                <span class="field-help">@AdminUx.Format("AllowedTools", server.Tools.Count(t => t.Enabled), server.Tools.Count)</span>
                            </div>
                            @if (!toolsAvailable) { <p class="hierarchy-hint">@AdminUx.Text("InactiveGrant")</p> }
                            <div class="tool-filters">
                                <label>@AdminUx.Text("SearchTools")<input type="search" class="native-select" @bind="_toolSearch" @bind:event="oninput" placeholder="@AdminUx.Text("SearchPlaceholder")" /></label>
                                <label>@AdminUx.Text("Access")<select class="native-select" @bind="_accessFilter"><option value="all">@AdminUx.Text("All")</option><option value="allowed">@AdminUx.Text("Allowed")</option><option value="blocked">@AdminUx.Text("Blocked")</option></select></label>
                                <label>@AdminUx.Text("Risk")<select class="native-select" @bind="_riskFilter"><option value="all">@AdminUx.Text("All")</option>@foreach (var risk in Enum.GetValues<ToolRisk>()) { <option value="@risk.ToString()">@ToolRiskPresentation.Label(risk)</option> }</select></label>
                            </div>
                            <div class="grant-comparison">
                                <label>@AdminUx.Text("CompareWith")<select class="native-select" @bind="_compareKeyId"><option value="">@AdminUx.Text("None")</option>@foreach (var key in _editor.ApiKeys.Where(k => k.Id != access.Id)) { <option value="@key.Id">@key.Name</option> }</select></label>
                                @if (ComparisonKey is not null) { <label class="inline-check"><input type="checkbox" @bind="_differencesOnly" /><span>@AdminUx.Text("DifferencesOnly")</span></label> }
                            </div>
                            <div class="tool-list-actions">
                                <span class="field-help">@AdminUx.Format("ShownTools", FilteredTools.Count, server.Tools.Count)</span>
                                <div class="bulk-actions">
                                    <button type="button" disabled="@(!server.CatalogEnabled || server.MetadataLoading)" @onclick="() => DiscoverToolDetailsAsync(server.Id)">@(server.MetadataLoading ? "Discovering…" : server.MetadataLoaded ? "Refresh tool details" : "Discover tool details")</button>
                                    <button type="button" disabled="@(!toolsAvailable || FilteredTools.Count == 0)" @onclick="() => SetFilteredTools(true)">@AdminUx.Format("AllowShown", FilteredTools.Count)</button>
                                    <button type="button" disabled="@(!toolsAvailable || FilteredTools.Count == 0)" @onclick="() => SetFilteredTools(false)">@AdminUx.Format("BlockShown", FilteredTools.Count)</button>
                                    <button type="button" disabled="@(_undoTools is null)" @onclick="UndoToolChanges">@AdminUx.Text("Undo")</button>
                                </div>
                            </div>
                            @if (server.MetadataDiscoveredAt is { } discoveredAt) { <p class="tool-discovery-time">@AdminUx.Format("DiscoveredAt", discoveredAt.ToString("u"))</p> }
                            @if (!string.IsNullOrWhiteSpace(server.MetadataError)) { <p class="tool-metadata-note tool-metadata-error" role="alert">@server.MetadataError</p> }
                            @if (!string.IsNullOrWhiteSpace(server.MetadataWarning)) { <p class="tool-metadata-note tool-metadata-warning" role="alert">@server.MetadataWarning</p> }
                            <div class="tool-table">
                                <div class="tool-row tool-row-header" aria-hidden="true"><span>Tool</span><span>Access</span></div>
                                @foreach (var tool in FilteredTools)
                                {
                                    <div class="tool-row @ToolRiskPresentation.CssClass(tool.Risk)" @key="tool.Name">
                                        <div class="tool-identity">
                                            <div class="tool-name-line"><code>@tool.Name</code><ToolRiskBadge Annotations="tool.Annotations" /></div>
                                            <span class="tool-description">@(tool.Description ?? AdminUx.Text("MetadataNotLoaded"))</span>
                                            @if (tool.Description is not null || tool.InputSchema is not null) { <details class="tool-schema"><summary>@AdminUx.Text("Details")</summary><p>@tool.Description</p>@if (tool.InputSchema is not null) { <pre>@tool.InputSchema</pre> }</details> }
                                            @if (tool.AvailableInDiscovery == false) { <strong class="tool-availability-warning">Unavailable in latest discovery; stored grant preserved.</strong> }
                                            @if (tool.SchemaChanged) { <strong class="tool-availability-warning">Input schema changed; review before use.</strong> }
                                            @if (ComparisonKey is { } compared) { <small class="comparison-value">@compared.Name: @(ComparisonAllows(tool.Name) ? AdminUx.Text("Allowed") : AdminUx.Text("Blocked"))</small> }
                                        </div>
                                        <label class="inline-check"><InputCheckbox @bind-Value="tool.Enabled" disabled="@(!toolsAvailable)" aria-label="@($"Allow tool {tool.Name} for API key {access.Id}")" /><span class="sr-only">Allow @tool.Name</span></label>
                                    </div>
                                }
                                @if (FilteredTools.Count == 0) { <p class="empty-state">@AdminUx.Text("NoMatchingTools")</p> }
                            </div>
                        }
                    </section>
                }
            }
        }
        @if (!string.IsNullOrWhiteSpace(_status)) { <LumexAlert Color="@(_statusKind == "error" ? ThemeColor.Danger : ThemeColor.Default)" Description="@_status" /> }
        </div>
        </fieldset>
    </EditForm>
    <LumexModal @bind-Open="_confirmDiscard">
        <LumexModalContent><LumexModalHeader>@AdminUx.Text("DiscardTitle")</LumexModalHeader><LumexModalBody>@AdminUx.Text("DiscardDescription")</LumexModalBody><LumexModalFooter><LumexButton Variant="@Variant.Light" OnClick="CancelDiscard">Cancel</LumexButton><LumexButton Color="@ThemeColor.Warning" OnClick="ConfirmDiscard">@AdminUx.Text("Discard")</LumexButton></LumexModalFooter></LumexModalContent>
    </LumexModal>
    <LumexModal @bind-Open="_confirmDelete">
        <LumexModalContent><LumexModalHeader>Delete project @Project.Name?</LumexModalHeader><LumexModalBody><p>This permanently removes project <code>@Project.Id</code>, its access configuration, and its stored artifacts. New requests will stop working immediately.</p></LumexModalBody><LumexModalFooter><LumexButton Variant="@Variant.Light" OnClick="CancelDelete">Cancel</LumexButton><LumexButton Color="@ThemeColor.Danger" Disabled="@_busy" OnClick="DeleteAsync">Delete project</LumexButton></LumexModalFooter></LumexModalContent>
    </LumexModal>
</article>
