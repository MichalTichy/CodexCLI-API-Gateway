@namespace CodexGateway.App.Components.Pages.Admin.Projects

<section class="content-section" aria-labelledby="projects-heading">
    <div class="section-title-row">
        <div>
            <h2 id="projects-heading">Projects</h2>
            <p>Isolated workspaces with key-specific MCP access.</p>
        </div>
        <LumexChip Variant="@ChipVariant.Flat">@Projects.Count configured</LumexChip>
    </div>

    <EditForm Model="_create" OnValidSubmit="CreateAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="flex-col items-start gap-1">
                <h3>Create project</h3>
                <p>Start with a project boundary, then choose which credentials and tools may enter it.</p>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-5">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <LumexTextbox id="new-project-id" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Id" Label="Identifier" Placeholder="customer-support" Description="Used in the API path and project header." LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Id" />
                    </div>
                    <div>
                        <LumexTextbox id="new-project-name" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Name" Label="Display name" Placeholder="Customer support" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Name" />
                    </div>
                </div>
                <div class="flex justify-end">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@_busy">@(_busy ? "Creating…" : "Create project")</LumexButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <LumexAlert Color="@(_statusKind == "error" ? ThemeColor.Danger : ThemeColor.Default)" Description="@_status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>

    @if (Projects.Count == 0)
    {
        <div class="empty-state">No projects have been created.</div>
    }
    else
    {
        <div class="grid gap-4">
            @foreach (var project in Projects)
            {
                <ProjectEditor Project="project"
                               ApiKeys="ApiKeys"
                               Servers="Servers"
                               OnChanged="OnChanged"
                               @key="project.Id" />
            }
        </div>
    }
</section>
