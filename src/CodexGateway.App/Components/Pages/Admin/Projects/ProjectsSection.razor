@namespace CodexGateway.App.Components.Pages.Admin.Projects

<section class="content-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="sr-only">Project management</h2>
    <div class="concept-callout">
        <span class="concept-icon" aria-hidden="true">i</span>
        <div>
            <strong>A project is an isolated execution boundary.</strong>
            <p>Its ID identifies API requests. Each granted API key can access only the MCP servers and tools selected inside that project.</p>
        </div>
    </div>

    <details class="creation-panel"><summary>@AdminUx.Text("NewProject")</summary>
    <EditForm Model="_create" OnValidSubmit="CreateAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="flex-col items-start gap-1">
                <h3>Create project</h3>
                <p>Start with a project boundary, then choose which credentials and tools may enter it.</p>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-5">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <div class="field-label-row">
                            <label for="new-project-id">Project ID</label>
                            <ContextHelp Title="Project ID">Unique and immutable. Clients send this value in the API path or project header to select the isolation boundary.</ContextHelp>
                        </div>
                        <LumexTextbox id="new-project-id" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Id" aria-label="Project ID" Placeholder="e.g. customer-support" Variant="@InputVariant.Outlined" />
                        <p class="field-help">Used in the API path and project header.</p>
                        <ValidationMessage For="() => _create.Id" />
                    </div>
                    <div>
                        <div class="field-label-row">
                            <label for="new-project-name">Display name</label>
                            <ContextHelp Title="Display name">Friendly name shown in this administration UI. It does not change the Project ID used by clients.</ContextHelp>
                        </div>
                        <LumexTextbox id="new-project-name" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Name" aria-label="Display name" Placeholder="e.g. Customer support" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Name" />
                    </div>
                </div>
                <div class="form-actions">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@_busy" Class="mobile-full-action">@(_busy ? "Creating…" : "Create project")</LumexButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <LumexAlert Color="@(_statusKind == "error" ? ThemeColor.Danger : ThemeColor.Default)" Description="@_status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>
    </details>

    <label class="list-search">@AdminUx.Text("SearchProjects")<input type="search" class="native-select" @bind="_search" @bind:event="oninput" /></label>
    <div class="management-list">
        @foreach (var project in FilteredProjects)
        {
            <button type="button" class="management-row @(project.Id == _selectedProjectId ? "selected-row" : null)" @onclick="() => OpenProject(project.Id)">
                <span><strong>@project.Name</strong><small>@project.Id · @ProjectSummary(project)</small></span><span>@(project.Enabled ? "Enabled" : "Disabled") →</span>
            </button>
        }
        @if (FilteredProjects.Count == 0) { <p class="empty-state">@AdminUx.Text("NoMatchingProjects")</p> }
    </div>
    @foreach (var project in Projects.Where(p => _openedProjects.Contains(p.Id)))
    {
        <div hidden="@(project.Id != _selectedProjectId)" @key="project.Id">
            <ProjectEditor Project="project" ApiKeys="ApiKeys" Servers="Servers" OnChanged="OnChanged" FocusedApiKeyId="@RequestedApiKeyId" FocusRequestVersion="AccessRequestVersion" />
        </div>
    }
</section>
