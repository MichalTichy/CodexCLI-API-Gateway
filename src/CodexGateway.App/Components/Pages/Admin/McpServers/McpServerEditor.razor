@namespace CodexGateway.App.Components.Pages.Admin.McpServers

<article aria-busy="@_busy.ToString().ToLowerInvariant()">
    <EditForm Model="_editor" OnValidSubmit="SaveAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="responsive-row">
                <div>
                    <h3>@Server.Name</h3>
                    <div class="mt-2 flex flex-wrap gap-2">
                        <LumexChip Color="@(Server.Enabled ? ThemeColor.Success : ThemeColor.Default)" Variant="@ChipVariant.Dot" Size="@Size.Small">@(Server.Enabled ? "Enabled" : "Disabled")</LumexChip>
                        <LumexChip Variant="@ChipVariant.Flat" Size="@Size.Small">@(Server is HttpMcpServerDefinition ? "HTTP" : "STDIO")</LumexChip>
                        <LumexChip Variant="@ChipVariant.Flat" Size="@Size.Small">@Server.ExecutionMode</LumexChip>
                    </div>
                    <span class="mt-2 block font-mono text-xs text-foreground-400">@Server.Id</span>
                </div>
                <div class="flex flex-wrap justify-end gap-2">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@_busy">@(_busy ? "Saving…" : "Save server")</LumexButton>
                    @if (_confirmDelete)
                    {
                        <div class="confirmation-panel" role="group" aria-label="Confirm server deletion">
                            <span>Remove this server from every project?</span>
                            <LumexButton Color="@ThemeColor.Danger" Size="@Size.Small" Disabled="@_busy" OnClick="DeleteAsync">Confirm</LumexButton>
                            <LumexButton Variant="@Variant.Light" Size="@Size.Small" Disabled="@_busy" OnClick="CancelDelete">Cancel</LumexButton>
                        </div>
                    }
                    else
                    {
                        <LumexButton Color="@ThemeColor.Danger" Variant="@Variant.Light" Disabled="@_busy" OnClick="ConfirmDelete">Delete</LumexButton>
                    }
                </div>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-5">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <LumexTextbox id="@($"server-name-{Server.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Name" Label="Display name" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _editor.Name" />
                    </div>
                    <div class="native-field">
                        <label for="@($"server-transport-{Server.Id}")">Transport</label>
                        <InputSelect id="@($"server-transport-{Server.Id}")" class="native-select" @bind-Value="_editor.IsHttp">
                            <option value="true">HTTP</option>
                            <option value="false">STDIO</option>
                        </InputSelect>
                    </div>
                    <div class="native-field">
                        <label for="@($"server-execution-{Server.Id}")">Execution</label>
                        <InputSelect id="@($"server-execution-{Server.Id}")" class="native-select" @bind-Value="_editor.ExecutionMode">
                            <option value="@McpExecutionMode.Gateway">Gateway</option>
                            <option value="@McpExecutionMode.Runner">Runner (advanced)</option>
                        </InputSelect>
                    </div>
                    <label class="toggle-field" for="@($"server-enabled-{Server.Id}")">
                        <InputCheckbox id="@($"server-enabled-{Server.Id}")" @bind-Value="_editor.Enabled" />
                        <span><strong>Enabled</strong><small>Available for project grants</small></span>
                    </label>

                    @if (_editor.IsHttp)
                    {
                        <LumexTextbox id="@($"server-url-{Server.Id}")" Type="@InputType.Url" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Url" Label="HTTP URL" Placeholder="https://mcp.internal.example" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" Class="sm:col-span-2" />
                        <LumexTextarea id="@($"server-environment-headers-{Server.Id}")"
                                       Behavior="@InputBehavior.OnInput"
                                       @bind-Value="_editor.EnvironmentHeaders"
                                       Label="HTTP headers from environment"
                                       Description="One mapping per line. Each environment variable contains the complete header value."
                                       Placeholder="Authorization=MCP_AUTHORIZATION&#10;X-Api-Key=MCP_API_KEY"
                                       LabelPlacement="@LabelPlacement.Outside"
                                       Variant="@InputVariant.Outlined"
                                       MinRows="3"
                                       Class="sm:col-span-2" />
                    }
                    else
                    {
                        <LumexTextbox id="@($"server-command-{Server.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Command" Label="STDIO command" Placeholder="mcp-server" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" Class="sm:col-span-2" />
                        <LumexTextarea id="@($"server-arguments-{Server.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.Arguments" Label="Arguments" Description="One argument per line." LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" MinRows="3" />
                        <LumexTextarea id="@($"server-env-{Server.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.EnvironmentVariables" Label="Forwarded environment variables" Description="One variable name per line." LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" MinRows="3" />
                    }

                    <LumexTextarea id="@($"server-tools-{Server.Id}")" Behavior="@InputBehavior.OnInput" @bind-Value="_editor.AvailableTools" Label="Available tools" Description="One tool name per line." LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" MinRows="4" Class="sm:col-span-2" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <LumexAlert Color="@(_statusKind == "error" ? ThemeColor.Danger : ThemeColor.Default)" Description="@_status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>
</article>
