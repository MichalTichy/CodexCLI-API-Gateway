@namespace CodexGateway.App.Components.Pages.Admin.McpServers
@inherits AdminComponentBase

<section class="content-section" aria-labelledby="mcp-heading">
    <div class="section-title-row">
        <div>
            <h2 id="mcp-heading">Trusted MCP catalog</h2>
            <p>Only servers registered here can be assigned to projects.</p>
        </div>
        <LumexChip Variant="@ChipVariant.Flat">@Servers.Count configured</LumexChip>
    </div>

    <EditForm Model="_create" OnValidSubmit="CreateAsync" autocomplete="off">
        <LumexCard Class="form-card">
            <LumexCardHeader Class="flex-col items-start gap-1">
                <h3>Add MCP server</h3>
                <p>Define the transport and the tools this gateway may expose.</p>
            </LumexCardHeader>
            <LumexDivider />
            <LumexCardBody Class="gap-5">
                <DataAnnotationsValidator />
                <div class="form-grid-two">
                    <div>
                        <LumexTextbox id="new-server-id" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Id" Label="Identifier" Placeholder="docs" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Id" />
                    </div>
                    <div>
                        <LumexTextbox id="new-server-name" Behavior="@InputBehavior.OnInput" @bind-Value="_create.Name" Label="Display name" Placeholder="Documentation" LabelPlacement="@LabelPlacement.Outside" Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Name" />
                    </div>
                    <div class="native-field">
                        <label for="new-server-transport">Transport</label>
                        <InputSelect id="new-server-transport" class="native-select" @bind-Value="_create.IsHttp">
                            <option value="true">HTTP</option>
                            <option value="false">STDIO</option>
                        </InputSelect>
                    </div>
                    <div class="native-field">
                        <label for="new-server-execution">Execution</label>
                        <InputSelect id="new-server-execution" class="native-select" @bind-Value="_create.ExecutionMode">
                            <option value="@McpExecutionMode.Gateway">Gateway</option>
                            <option value="@McpExecutionMode.Runner">Runner (advanced)</option>
                        </InputSelect>
                    </div>
                    <div class="sm:col-span-2">
                        <LumexTextbox id="new-server-location"
                                      Behavior="@InputBehavior.OnInput"
                                      @bind-Value="_create.Location"
                                      Label="@(_create.IsHttp ? "HTTP URL" : "Command")"
                                      Placeholder="@(_create.IsHttp ? "https://mcp.internal.example" : "mcp-server")"
                                      LabelPlacement="@LabelPlacement.Outside"
                                      Variant="@InputVariant.Outlined" />
                        <ValidationMessage For="() => _create.Location" />
                    </div>
                    @if (_create.IsHttp)
                    {
                        <LumexTextarea id="new-server-environment-headers"
                                       Behavior="@InputBehavior.OnInput"
                                       @bind-Value="_create.EnvironmentHeaders"
                                       Label="HTTP headers from environment"
                                       Description="One mapping per line. Each environment variable contains the complete header value."
                                       Placeholder="Authorization=MCP_AUTHORIZATION&#10;X-Api-Key=MCP_API_KEY"
                                       LabelPlacement="@LabelPlacement.Outside"
                                       Variant="@InputVariant.Outlined"
                                       MinRows="3"
                                       Class="sm:col-span-2" />
                    }
                    <LumexTextarea id="new-server-tools"
                                   Behavior="@InputBehavior.OnInput"
                                   @bind-Value="_create.AvailableTools"
                                   Label="Available tools"
                                   Description="One tool name per line."
                                   Placeholder="search&#10;open"
                                   LabelPlacement="@LabelPlacement.Outside"
                                   Variant="@InputVariant.Outlined"
                                   MinRows="3"
                                   Class="sm:col-span-2" />
                </div>
                <div class="flex justify-end">
                    <LumexButton Type="@ButtonType.Submit" Color="@ThemeColor.Primary" Disabled="@IsBusy">@(IsBusy ? "Adding…" : "Add trusted server")</LumexButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(Status))
                {
                    <LumexAlert Color="@(StatusKind == AdminStatusKind.Error ? ThemeColor.Danger : ThemeColor.Default)" Description="@Status" />
                }
            </LumexCardBody>
        </LumexCard>
    </EditForm>

    @if (Servers.Count == 0)
    {
        <div class="empty-state">No trusted MCP servers have been added.</div>
    }
    else
    {
        <div class="grid gap-4">
            @foreach (var server in Servers)
            {
                <McpServerEditor Server="server" OnChanged="OnChanged" @key="server.Id" />
            }
        </div>
    }
</section>
