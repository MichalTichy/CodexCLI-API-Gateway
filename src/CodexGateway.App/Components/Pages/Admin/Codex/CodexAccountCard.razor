@namespace CodexGateway.App.Components.Pages.Admin.Codex
@inherits AdminComponentBase

<LumexCard Class="form-card" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <LumexCardBody Class="gap-5">
        @if (!string.IsNullOrWhiteSpace(LoadError) && Login is not { Status: DeviceLoginStatus.Pending })
        {
            <div class="responsive-row">
                <div class="flex items-start gap-4">
                    <div class="status-orb status-orb-danger" aria-hidden="true">!</div>
                    <div>
                        <h3>Account status unavailable</h3>
                        <p class="mt-1 text-sm text-danger" role="alert">@LoadError</p>
                    </div>
                </div>
                <LumexButton Variant="@Variant.Flat" Disabled="@IsBusy" OnClick="RetryAsync">Retry</LumexButton>
            </div>
        }
        else if (Account?.Authenticated == true)
        {
            <div class="responsive-row">
                <div class="flex items-center gap-4">
                    <div class="status-orb status-orb-success" aria-hidden="true">✓</div>
                    <div>
                        <h3>@(Account.Email ?? "Signed in with ChatGPT")</h3>
                        @if (string.IsNullOrWhiteSpace(Account.Email))
                        {
                            <p class="mt-1 text-sm text-foreground-500">Codex CLI does not expose which ChatGPT account is connected.</p>
                        }
                        <div class="mt-2 flex flex-wrap gap-2">
                            <LumexChip Color="@ThemeColor.Success" Variant="@ChipVariant.Dot" Size="@Size.Small">Connection verified</LumexChip>
                            <span class="verification-time">@LastVerifiedLabel</span>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap justify-end gap-2">
                    <LumexButton Variant="@Variant.Light" Disabled="@IsBusy" OnClick="RetryAsync">Check connection</LumexButton>
                    <LumexButton Color="@ThemeColor.Danger" Variant="@Variant.Light" Disabled="@IsBusy" OnClick="ConfirmLogout">Log out of Codex</LumexButton>
                </div>
            </div>
        }
        else if (Login is { Status: DeviceLoginStatus.Pending })
        {
            <div class="grid gap-5">
                <div class="responsive-row">
                    <div class="flex items-start gap-4">
                        <div class="status-orb status-orb-warning" aria-hidden="true">→</div>
                        <div>
                            <h3>Complete device login</h3>
                            <p class="mt-1 text-sm text-foreground-500">Open the verification page, enter the code below, and return here. This page checks the connection automatically.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap justify-end gap-2">
                        @if (!string.IsNullOrWhiteSpace(LoadError))
                        {
                            <LumexButton Variant="@Variant.Light" Disabled="@IsBusy" OnClick="RetryAsync">Retry status</LumexButton>
                        }
                        <LumexButton Variant="@Variant.Light" Disabled="@IsBusy" OnClick="CancelLoginAsync">Cancel login</LumexButton>
                    </div>
                </div>
                <div class="device-login-panel">
                    <div>
                        <span class="block text-xs font-semibold uppercase tracking-wider text-foreground-400">Device code</span>
                        <code class="device-code" aria-label="Codex device code">@Login.UserCode</code>
                        <span class="mt-2 block text-xs text-foreground-500">@LoginExpiryLabel Do not share this code with anyone else.</span>
                    </div>
                    <div class="device-login-actions">
                        <LumexButton Type="@ButtonType.Button" Variant="@Variant.Flat" OnClick="CopyCodeAsync">@(_codeCopied ? "Copied" : "Copy code")</LumexButton>
                        <LumexButton As="a" href="@Login.VerificationUrl" target="_blank" rel="noopener noreferrer" Color="@ThemeColor.Primary">Open verification page</LumexButton>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(LoadError))
                {
                    <LumexAlert Color="@ThemeColor.Warning" Description="Unable to check the current login status. The code remains valid; retry the status check or continue on the verification page." />
                }
                @if (!string.IsNullOrWhiteSpace(Login.Error))
                {
                    <LumexAlert Color="@ThemeColor.Danger" Description="@Login.Error" />
                }
            </div>
        }
        else
        {
            <div class="responsive-row">
                <div class="flex items-center gap-4">
                    <div class="status-orb" aria-hidden="true">○</div>
                    <div>
                        <h3>@(Login is { Status: DeviceLoginStatus.Failed } && Login.Error?.Contains("expired", StringComparison.OrdinalIgnoreCase) == true ? "Device code expired" : "Codex is not connected")</h3>
                        <p class="mt-1 text-sm text-foreground-500">@(Login is { Status: DeviceLoginStatus.Failed } && Login.Error?.Contains("expired", StringComparison.OrdinalIgnoreCase) == true ? "Generate a new device code to continue." : "Connect the shared Codex account before running requests. Projects remain isolated, but they all use this login.")</p>
                        @if (Login is not null && !string.IsNullOrWhiteSpace(Login.Error))
                        {
                            <p class="mt-2 text-sm text-danger" role="alert">@Login.Error</p>
                        }
                    </div>
                </div>
                <LumexButton Color="@ThemeColor.Primary" Disabled="@IsBusy" OnClick="StartLoginAsync">
                    @(IsBusy ? "Starting device login…" : Login is { Status: DeviceLoginStatus.Failed } && Login.Error?.Contains("expired", StringComparison.OrdinalIgnoreCase) == true ? "Generate new code" : "Connect Codex")
                </LumexButton>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Status))
        {
            <LumexAlert Color="@(StatusKind == AdminStatusKind.Error ? ThemeColor.Danger : ThemeColor.Default)" Description="@Status" />
        }
    </LumexCardBody>
</LumexCard>

<LumexModal @bind-Open="_confirmLogout" ShowCloseButton="@false">
    <LumexModalContent>
        <LumexModalHeader>Log out of Codex?</LumexModalHeader>
        <LumexModalBody>
            <div class="grid gap-3 text-sm leading-6 text-foreground-600">
                <p>New runs will fail until an administrator connects Codex again. Running containers are not interrupted, but any later Codex request may fail after their current credentials expire.</p>
                <p>The gateway removes the shared Codex authentication from its host directory.</p>
            </div>
        </LumexModalBody>
        <LumexModalFooter>
            <LumexButton Variant="@Variant.Light" autofocus OnClick="CancelLogout">Cancel</LumexButton>
            <LumexButton Color="@ThemeColor.Danger" Disabled="@IsBusy" OnClick="LogoutAsync">Log out of Codex</LumexButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
