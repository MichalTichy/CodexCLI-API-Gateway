@namespace CodexGateway.App.Components.Pages.Admin.Codex
@inherits AdminComponentBase

<LumexCard Class="form-card" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <LumexCardBody Class="gap-5">
        @if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="responsive-row">
                <div class="flex items-start gap-4">
                    <div class="status-orb status-orb-danger" aria-hidden="true">!</div>
                    <div>
                        <h3>Account status unavailable</h3>
                        <p class="mt-1 text-sm text-danger" role="alert">@LoadError</p>
                    </div>
                </div>
                <LumexButton Variant="@Variant.Flat" Disabled="@IsBusy" OnClick="RetryAsync">Retry</LumexButton>
            </div>
        }
        else if (Account?.Authenticated == true)
        {
            <div class="responsive-row">
                <div class="flex items-center gap-4">
                    <div class="status-orb status-orb-success" aria-hidden="true">✓</div>
                    <div>
                        <h3>@(Account.Email ?? "Authenticated account")</h3>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <LumexChip Color="@ThemeColor.Success" Variant="@ChipVariant.Dot" Size="@Size.Small">Authenticated</LumexChip>
                            @if (!string.IsNullOrWhiteSpace(Account.AccountType))
                            {
                                <LumexChip Variant="@ChipVariant.Flat" Size="@Size.Small">@Account.AccountType</LumexChip>
                            }
                        </div>
                    </div>
                </div>
                @if (_confirmLogout)
                {
                    <div class="confirmation-panel" role="group" aria-label="Confirm Codex logout">
                        <span>New runs will fail until you sign in again.</span>
                        <LumexButton Color="@ThemeColor.Danger" Size="@Size.Small" Disabled="@IsBusy" OnClick="LogoutAsync">Confirm logout</LumexButton>
                        <LumexButton Variant="@Variant.Light" Size="@Size.Small" Disabled="@IsBusy" OnClick="CancelLogout">Cancel</LumexButton>
                    </div>
                }
                else
                {
                    <LumexButton Color="@ThemeColor.Danger" Variant="@Variant.Light" Disabled="@IsBusy" OnClick="ConfirmLogout">Log out of Codex</LumexButton>
                }
            </div>
        }
        else if (Login is { Status: DeviceLoginStatus.Pending })
        {
            <div class="grid gap-5">
                <div class="responsive-row">
                    <div class="flex items-start gap-4">
                        <div class="status-orb status-orb-warning" aria-hidden="true">→</div>
                        <div>
                            <h3>Complete device login</h3>
                            <p class="mt-1 text-sm text-foreground-500">Open the verification page and enter the code below.</p>
                        </div>
                    </div>
                    <LumexButton Variant="@Variant.Light" Disabled="@IsBusy" OnClick="CancelLoginAsync">Cancel login</LumexButton>
                </div>
                <div class="device-login-panel">
                    <div>
                        <span class="block text-xs font-semibold uppercase tracking-wider text-foreground-400">Device code</span>
                        <code class="device-code">@Login.UserCode</code>
                    </div>
                    <LumexButton As="a" href="@Login.VerificationUrl" target="_blank" rel="noopener noreferrer" Color="@ThemeColor.Primary">Open verification page</LumexButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(Login.Error))
                {
                    <LumexAlert Color="@ThemeColor.Danger" Description="@Login.Error" />
                }
            </div>
        }
        else
        {
            <div class="responsive-row">
                <div class="flex items-center gap-4">
                    <div class="status-orb" aria-hidden="true">○</div>
                    <div>
                        <h3>Not authenticated</h3>
                        <p class="mt-1 text-sm text-foreground-500">Connect a dedicated Codex account before running requests.</p>
                        @if (Login is not null && !string.IsNullOrWhiteSpace(Login.Error))
                        {
                            <p class="mt-2 text-sm text-danger" role="alert">@Login.Error</p>
                        }
                    </div>
                </div>
                <LumexButton Color="@ThemeColor.Primary" Disabled="@IsBusy" OnClick="StartLoginAsync">
                    @(IsBusy ? "Working…" : "Start device login")
                </LumexButton>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Status))
        {
            <LumexAlert Color="@(StatusKind == AdminStatusKind.Error ? ThemeColor.Danger : ThemeColor.Default)" Description="@Status" />
        }
    </LumexCardBody>
</LumexCard>
