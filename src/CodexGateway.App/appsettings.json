{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "StoragePath": "data",
    "Limits": {
      "MaxConcurrent": 4,
      "MaxQueued": 32,
      "TimeoutMinutes": 30
    },
    "Files": {
      "MaxUploadMegabytes": 25,
      "ProjectlessTtlHours": 24,
      "AllowedExtensions": [
        ".txt", ".md", ".json", ".yaml", ".yml", ".csv", ".xml", ".html", ".css",
        ".js", ".ts", ".jsx", ".tsx", ".cs", ".fs", ".vb", ".py", ".java", ".go",
        ".rs", ".sql", ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp"
      ]
    },
    "Artifacts": {
      "MaxFiles": 10000,
      "MaxFileMegabytes": 512,
      "MaxTotalMegabytes": 2048
    }
  },
  "Codex": {
    "ExecutablePath": "codex",
    "ArgumentPrefix": [],
    "HomePath": ".codex-home",
    "Container": {
      "EngineExecutablePath": "docker",
      "EngineArgumentPrefix": [],
      "Image": "codex-gateway-runner:0.148.0",
      "WorkspaceVolume": null,
      "AuthVolume": null,
      "Network": "bridge",
      "MemoryMegabytes": 2048,
      "CpuLimit": 2,
      "PidsLimit": 256,
      "TmpfsMegabytes": 256
    },
    "ModelCacheSeconds": 300,
    "AppServerRequestTimeoutSeconds": 30,
    "DeviceLoginTimeoutMinutes": 15
  },
  "McpGateway": {
    "RunnerBaseUrl": "http://host.docker.internal:8080",
    "SessionLifetimeMinutes": 120
  },
  "AdminUi": {
    "Enabled": true,
    "Username": "admin",
    "Password": "internal-password"
  }
}
