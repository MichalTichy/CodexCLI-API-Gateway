{
  "method": "POST",
  "path_and_query": "/p/openai-compat/v1/chat/completions",
  "authorization": "Bearer <redacted>",
  "content_type": "application/json",
  "body": {
    "messages": [
      {
        "role": "user",
        "content": "Return the structured compatibility result."
      }
    ],
    "model": "gpt-test-sol",
    "response_format": {
      "type": "json_schema",
